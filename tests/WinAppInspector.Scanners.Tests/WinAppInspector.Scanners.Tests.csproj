<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Smoke tests that run the real scanners against the machine they execute on.
    Every test is marked [WindowsFact]: it runs on the windows-latest CI job and is skipped elsewhere.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>WinAppInspector.Scanners.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinAppInspector.Scanners\WinAppInspector.Scanners.csproj" />
    <ProjectReference Include="..\..\src\WinAppInspector.Actions\WinAppInspector.Actions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>

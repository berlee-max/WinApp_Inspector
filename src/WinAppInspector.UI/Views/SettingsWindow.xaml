<Window x:Class="WinAppInspector.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinAppInspector.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{StaticResource Settings.Title}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.WindowBackground}" FontFamily="{StaticResource Font.UI}">

  <StackPanel Margin="20">
    <TextBlock Text="{StaticResource Settings.ScanScope}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.ProgramFiles}" IsChecked="{Binding Draft.ScanProgramFiles}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.ProgramFilesX86}" IsChecked="{Binding Draft.ScanProgramFilesX86}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.ProgramData}" IsChecked="{Binding Draft.ScanProgramData}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.LocalAppData}" IsChecked="{Binding Draft.ScanLocalAppData}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.RoamingAppData}" IsChecked="{Binding Draft.ScanRoamingAppData}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.LocalLowAppData}" IsChecked="{Binding Draft.ScanLocalLowAppData}" Margin="0" />
      </StackPanel>
    </Border>

    <!-- User-added folders for portable software (§9.3, §26.1) -->
    <TextBlock Text="{StaticResource Settings.CustomDirectories}" Style="{StaticResource Text.Section}" Margin="0,16,0,8" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{StaticResource Settings.CustomDirectoriesHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding CustomDirectories}" SelectedItem="{Binding SelectedCustomDirectory}"
                 MinHeight="48" MaxHeight="120" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding CustomDirectoryError}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding CustomDirectoryError, Converter={StaticResource EmptyToCollapsed}}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Style="{StaticResource Toolbar.Button}" Content="{StaticResource Settings.AddDirectory}" Command="{Binding AddCustomDirectoryCommand}" />
          <Button Style="{StaticResource Toolbar.Button}" Content="{StaticResource Settings.RemoveDirectory}" Command="{Binding RemoveCustomDirectoryCommand}" Margin="8,0,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Text="{StaticResource Settings.Defaults}" Style="{StaticResource Text.Section}" Margin="0,16,0,8" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.RecycleBin}" IsChecked="{Binding Draft.RecycleBinFirst}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.RestorePoint}" IsChecked="{Binding Draft.CreateRestorePointBeforeUninstall}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.HideSystem}" IsChecked="{Binding Draft.HideSystemComponents}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.ReadSignatures}" IsChecked="{Binding Draft.ReadSignatures}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.ScanTasks}" IsChecked="{Binding Draft.ScanScheduledTasks}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.ScanServices}" IsChecked="{Binding Draft.ScanServices}" />
        <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Settings.ContextMenu}" IsChecked="{Binding Draft.ExplorerContextMenu}" Margin="0" />
      </StackPanel>
    </Border>

    <TextBlock Text="{StaticResource Settings.RescanHint}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource Toolbar.Button}" Content="{StaticResource Settings.Cancel}" Command="{Binding CancelCommand}" MinWidth="80" />
      <Button Style="{StaticResource Accent.Button}" Content="{StaticResource Settings.Save}" Command="{Binding SaveCommand}" MinWidth="80" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>

<UserControl x:Class="WinAppInspector.UI.Views.HeroEmblem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="290" Height="250">
  <!-- The product emblem: a glass hexagon with the four-pane mark and a spray of particles. Floats gently; while
       scanning a red scan ring pulses over the particles. Pure vectors, no images. -->
  <UserControl.Resources>
    <LinearGradientBrush x:Key="HexFill" StartPoint="0.1,0" EndPoint="0.9,1">
      <GradientStop Color="#3299DC" Offset="0" />
      <GradientStop Color="#075CC9" Offset="0.37" />
      <GradientStop Color="#0D18B3" Offset="0.71" />
      <GradientStop Color="#151078" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="HexGloss" Center="0.36,0.16" GradientOrigin="0.36,0.16" RadiusX="0.55" RadiusY="0.45">
      <GradientStop Color="#949AF2FF" Offset="0" />
      <GradientStop Color="#009AF2FF" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="PaneFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F1FBFF" Offset="0" />
      <GradientStop Color="#C3ECFF" Offset="0.45" />
      <GradientStop Color="#86DBFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DotFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#67E5FF" Offset="0" />
      <GradientStop Color="#119EF3" Offset="1" />
    </LinearGradientBrush>
    <Storyboard x:Key="Float" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="FloatTransform" Storyboard.TargetProperty="Y" From="0" To="-8" Duration="0:0:2.4">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="OrbitPulse" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="OrbitScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1.08" Duration="0:0:0.8" />
      <DoubleAnimation Storyboard.TargetName="OrbitScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1.08" Duration="0:0:0.8" />
      <DoubleAnimation Storyboard.TargetName="Orbit" Storyboard.TargetProperty="Opacity" From="0.72" To="1" Duration="0:0:0.8" />
    </Storyboard>
  </UserControl.Resources>
  <UserControl.Triggers>
    <EventTrigger RoutedEvent="Loaded">
      <BeginStoryboard Storyboard="{StaticResource Float}" />
      <BeginStoryboard Storyboard="{StaticResource OrbitPulse}" />
    </EventTrigger>
  </UserControl.Triggers>

  <Grid>
    <Grid.RenderTransform>
      <TranslateTransform x:Name="FloatTransform" />
    </Grid.RenderTransform>
    <Grid.Effect>
      <DropShadowEffect Color="#01134B" BlurRadius="34" ShadowDepth="20" Opacity="0.46" />
    </Grid.Effect>

    <!-- hexagon: 290 x 250 -->
    <Path Fill="{StaticResource HexFill}" Stroke="#A3AEF1FF" StrokeThickness="2"
          Data="M 72,8 L 218,8 L 284,70 L 284,175 L 218,240 L 72,240 L 6,175 L 6,70 Z" />
    <Path Fill="{StaticResource HexGloss}" Data="M 72,8 L 218,8 L 284,70 L 284,175 L 218,240 L 72,240 L 6,175 L 6,70 Z" />

    <!-- four-pane mark -->
    <Grid Width="101" Height="80" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0">
      <Grid.RenderTransform>
        <RotateTransform Angle="-3" CenterX="50" CenterY="40" />
      </Grid.RenderTransform>
      <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PaneFill}" CornerRadius="7,5,6,5" Margin="0,0,3.5,3.5" />
      <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource PaneFill}" CornerRadius="7,5,6,5" Margin="3.5,0,0,3.5" />
      <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PaneFill}" CornerRadius="7,5,6,5" Margin="0,3.5,3.5,0" />
      <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PaneFill}" CornerRadius="7,5,6,5" Margin="3.5,3.5,0,0" />
    </Grid>

    <!-- particles -->
    <Canvas Width="148" Height="58" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,160,0,0">
      <Border Canvas.Left="5" Canvas.Top="4" Width="18" Height="18" CornerRadius="5" Background="{StaticResource DotFill}" />
      <Border Canvas.Left="33" Canvas.Top="16" Width="14" Height="14" CornerRadius="4" Background="{StaticResource DotFill}" />
      <Border Canvas.Left="63" Canvas.Top="3" Width="20" Height="20" CornerRadius="5" Background="{StaticResource DotFill}" />
      <Border Canvas.Left="96" Canvas.Top="13" Width="17" Height="17" CornerRadius="5" Background="{StaticResource DotFill}" />
      <Border Canvas.Left="127" Canvas.Top="6" Width="14" Height="14" CornerRadius="4" Background="{StaticResource DotFill}" />
      <Border Canvas.Left="22" Canvas.Top="40" Width="9" Height="9" CornerRadius="3" Background="{StaticResource DotFill}" />
      <Border Canvas.Left="54" Canvas.Top="35" Width="11" Height="11" CornerRadius="3" Background="{StaticResource DotFill}" />
      <Border Canvas.Left="90" Canvas.Top="41" Width="10" Height="10" CornerRadius="3" Background="{StaticResource DotFill}" />
      <Border Canvas.Left="119" Canvas.Top="38" Width="8" Height="8" CornerRadius="3" Background="{StaticResource DotFill}" />
    </Canvas>

    <!-- scan ring, only while scanning -->
    <Grid x:Name="Orbit" Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,148,0,0" RenderTransformOrigin="0.5,0.5"
          Visibility="{Binding IsScanning, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="OrbitScale" />
      </Grid.RenderTransform>
      <Ellipse Stroke="#B8FF6F82" StrokeThickness="2" />
      <Ellipse Stroke="#88FF6F82" StrokeThickness="1" Margin="11" />
      <Ellipse Fill="#FF6A80" Margin="26" />
    </Grid>
  </Grid>
</UserControl>

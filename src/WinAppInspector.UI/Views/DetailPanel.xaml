<UserControl x:Class="WinAppInspector.UI.Views.DetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinAppInspector.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DetailViewModel}">

  <UserControl.Resources>
    <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:DetailRow}">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Text.Caption}" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 Padding="0" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Brush.TextPrimary}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Padding="16,14" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Source="{Binding Current.Icon}" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
               Visibility="{Binding Current.Icon, Converter={StaticResource EmptyToCollapsed}}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Current.Name}" Style="{StaticResource Text.Title}" FontSize="17" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Current.TypeText}" Style="{StaticResource Text.Caption}" />
            <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
            <TextBlock Text="{Binding Current.StatusText}" Style="{StaticResource Text.Caption}"
                       Foreground="{Binding Current.StatusTone, Converter={StaticResource StatusToneBrush}}" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource Link.Button}" Content="✕" FontSize="14" Command="{Binding CloseCommand}" VerticalAlignment="Top" />
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
      <StackPanel>
        <!-- §14.6 verdict first: the "why" is the core of the product -->
        <TextBlock Text="{StaticResource Detail.Verdict}" Style="{StaticResource Text.Section}" />
        <TextBlock Text="{Binding VerdictText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

        <TextBlock Text="{StaticResource Detail.Why}" Style="{StaticResource Text.Section}" />
        <ItemsControl ItemsSource="{Binding Reasons}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Converter={StaticResource ReasonMark}}" Style="{StaticResource Text.Body}" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource ReasonText}}" Style="{StaticResource Text.Body}" FontSize="13" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- §14.1 -->
        <TextBlock Text="{StaticResource Detail.Basic}" Style="{StaticResource Text.Section}" />
        <ItemsControl ItemsSource="{Binding BasicInfo}" ItemTemplate="{StaticResource RowTemplate}" />

        <!-- §14.2 -->
        <TextBlock Text="{StaticResource Detail.Install}" Style="{StaticResource Text.Section}" />
        <ItemsControl ItemsSource="{Binding InstallInfo}" ItemTemplate="{StaticResource RowTemplate}" />

        <!-- §14.3 -->
        <TextBlock Text="{StaticResource Detail.Directories}" Style="{StaticResource Text.Section}" />
        <ItemsControl ItemsSource="{Binding Directories}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}" Padding="0,4">
                <StackPanel>
                  <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" />
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding Role, Converter={StaticResource DirectoryRoleText}}" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding SizeBytes, Converter={StaticResource Bytes}}" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                    <Button Style="{StaticResource Link.Button}" Content="{StaticResource Detail.OpenLocation}"
                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Path}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding AttributionEvidence}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EvidenceText}}" Style="{StaticResource Text.Caption}" FontSize="11" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- §14.4 -->
        <TextBlock Text="{StaticResource Detail.Runtime}" Style="{StaticResource Text.Section}" />
        <TextBlock Text="{StaticResource Detail.NoProcesses}" Style="{StaticResource Text.Caption}"
                   Visibility="{Binding Processes, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
        <ItemsControl ItemsSource="{Binding Processes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Text.Mono}">
                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (PID " /><Run Text="{Binding ProcessId, Mode=OneWay}" /><Run Text=")  " /><Run Text="{Binding ExecutablePath, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- §14.5 -->
        <TextBlock Text="{StaticResource Detail.Links}" Style="{StaticResource Text.Section}" />
        <TextBlock Text="{StaticResource Detail.NoLinks}" Style="{StaticResource Text.Caption}"
                   Visibility="{Binding HasLinks, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
        <ItemsControl ItemsSource="{Binding StartupItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Text.Mono}">
                <Run Text="{StaticResource Detail.StartupItems}" /><Run Text=": " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding Command, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Services}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Text.Mono}">
                <Run Text="{StaticResource Detail.Services}" /><Run Text=": " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding State, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding StartMode, Mode=OneWay}" /><Run Text=") " /><Run Text="{Binding ExecutablePath, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding ScheduledTasks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Text.Mono}">
                <Run Text="{StaticResource Detail.ScheduledTasks}" /><Run Text=": " /><Run Text="{Binding FullPath, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding Execute, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- §10.2 evidence summary -->
        <TextBlock Text="{StaticResource Detail.EvidenceTitle}" Style="{StaticResource Text.Section}"
                   Visibility="{Binding Evidence, Converter={StaticResource EmptyToCollapsed}}" />
        <ItemsControl ItemsSource="{Binding Evidence}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EvidenceText}}" Style="{StaticResource Text.Body}" FontSize="12" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

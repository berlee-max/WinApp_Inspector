<Window x:Class="WinAppInspector.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Nav.About}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.WindowBackground}" FontFamily="{StaticResource Font.UI}">

  <StackPanel Margin="20">
    <TextBlock Text="{StaticResource App.Title}" Style="{StaticResource Text.Title}" />
    <TextBlock Text="{StaticResource App.Version}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
    <TextBlock Text="{StaticResource App.AboutText}" Style="{StaticResource Text.Body}" />
    <TextBlock Text="{StaticResource Placeholder.Boundary}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
    <Button Style="{StaticResource Toolbar.Button}" Content="{StaticResource About.Close}" HorizontalAlignment="Right" MinWidth="80" Margin="0,16,0,0" Click="CloseClick" />
  </StackPanel>
</Window>

<UserControl x:Class="WinAppInspector.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinAppInspector.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- §13.1 statistics -->
    <ItemsControl Grid.Row="0" ItemsSource="{Binding Stats}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource StatTile}">
            <StackPanel>
              <TextBlock Text="{Binding Count}" Style="{StaticResource Text.Title}" />
              <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- §13.3 filter + §13.4 search -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <ItemsControl Grid.Column="0" ItemsSource="{Binding Filters}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Style="{StaticResource Filter.Chip}" GroupName="Filter" Content="{Binding Label}"
                         Tag="{Binding Filter}" Checked="FilterChecked" IsChecked="{Binding IsDefault, Mode=OneTime}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <CheckBox Grid.Column="1" Style="{StaticResource Check.Body}" Margin="12,0" VerticalAlignment="Center"
                Content="{StaticResource Filter.ShowSystem}" IsChecked="{Binding ShowSystemComponents, Mode=TwoWay}" />

      <TextBox Grid.Column="2" Style="{StaticResource Search.TextBox}" VerticalAlignment="Center"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
    </Grid>

    <!-- §13.2 list -->
    <Grid Grid.Row="2">
      <ListView x:Name="AppList" Style="{StaticResource List.View}" ItemsSource="{Binding View}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single"
                GridViewColumnHeader.Click="HeaderClick">
        <ListView.View>
          <GridView ColumnHeaderContainerStyle="{StaticResource List.Header}">
            <GridViewColumn Width="300">
              <GridViewColumnHeader Content="{StaticResource Column.Name}" Tag="Name" />
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                           Visibility="{Binding Icon, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Cell}" />
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="180">
              <GridViewColumnHeader Content="{StaticResource Column.Publisher}" Tag="Publisher" />
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.CellSecondary}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="110">
              <GridViewColumnHeader Content="{StaticResource Column.Version}" Tag="Version" />
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Version}" Style="{StaticResource Text.CellSecondary}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="120">
              <GridViewColumnHeader Content="{StaticResource Column.Type}" Tag="TypeText" />
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding TypeText}" Style="{StaticResource Text.Cell}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="320">
              <GridViewColumnHeader Content="{StaticResource Column.InstallLocation}" Tag="InstallLocation" />
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding InstallLocation}" Style="{StaticResource Text.CellSecondary}" ToolTip="{Binding InstallLocation}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="100">
              <GridViewColumnHeader Content="{StaticResource Column.DiskUsage}" Tag="DiskUsageBytes" />
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DiskUsageText}" Style="{StaticResource Text.CellSecondary}" HorizontalAlignment="Right" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="90">
              <GridViewColumnHeader Content="{StaticResource Column.Status}" Tag="StatusText" />
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Cell}"
                             Foreground="{Binding StatusTone, Converter={StaticResource StatusToneBrush}}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>

      <TextBlock Text="{StaticResource Overview.Empty}" Style="{StaticResource Text.Caption}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding Items.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
    </Grid>
  </Grid>
</UserControl>

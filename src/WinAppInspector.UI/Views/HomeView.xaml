<UserControl x:Class="WinAppInspector.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinAppInspector.UI.ViewModels"
             xmlns:views="clr-namespace:WinAppInspector.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

  <!-- The hero page: home → scanning → summary. Deep blue gradient, white type, one round action button. -->
  <Grid Background="{StaticResource Hero.Background}">
    <!-- Top strip: page title centred, quiet links right, "重新扫描" left on the summary -->
    <Grid VerticalAlignment="Top" Margin="22,14,22,0" Height="30">
      <Button Style="{StaticResource Hero.Link}" HorizontalAlignment="Left" Command="{Binding StartScanCommand}"
              Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}}">
        <TextBlock><Run Text="↶ " FontSize="16" /><Run Text="{StaticResource Summary.Rescan}" /></TextBlock>
      </Button>
      <TextBlock Text="{StaticResource App.Title}" Style="{StaticResource Hero.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Hero.Link}" Content="{StaticResource Nav.Settings}" Command="{Binding OpenSettingsCommand}" />
        <Button Style="{StaticResource Hero.Link}" Content="{StaticResource Nav.OperationLog}" Command="{Binding OpenOperationLogCommand}" />
        <Button Style="{StaticResource Hero.Link}" Content="{StaticResource Nav.About}" Command="{Binding OpenAboutCommand}" />
      </StackPanel>
    </Grid>

    <!-- HOME -->
    <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" Margin="78,60,82,110">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.92*" />
        <ColumnDefinition Width="1.08*" />
      </Grid.ColumnDefinitions>
      <views:HeroEmblem Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
        <TextBlock Text="{StaticResource Home.Title}" Style="{StaticResource Hero.Title}" />
        <TextBlock Text="{StaticResource Home.Subtitle}" Style="{StaticResource Hero.Body}" Margin="0,15,0,27" MaxWidth="510" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
          <Border Style="{StaticResource Hero.Bullet}">
            <Path Style="{StaticResource Hero.BulletIcon}" Data="M4,7 H20 M9,7 V4 H15 V7 M8,10 V17 M12,10 V17 M16,10 V17 M6,7 L7,20 H17 L18,7" />
          </Border>
          <TextBlock Text="{StaticResource Home.Feature1}" Style="{StaticResource Hero.Feature}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
          <Border Style="{StaticResource Hero.Bullet}">
            <Path Style="{StaticResource Hero.BulletIcon}" Data="M12,4 V20 M4,12 H20 M7,7 L17,17 M17,7 L7,17" />
          </Border>
          <TextBlock Text="{StaticResource Home.Feature2}" Style="{StaticResource Hero.Feature}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Style="{StaticResource Hero.Bullet}">
            <Path Style="{StaticResource Hero.BulletIcon}" Data="M4,17 L8,13 L11,16 L17,8 L20,11 M4,20 H20" />
          </Border>
          <TextBlock Text="{StaticResource Home.Feature3}" Style="{StaticResource Hero.Feature}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- SCANNING -->
    <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,54,0,0" MaxWidth="760">
      <views:HeroEmblem IsScanning="True" HorizontalAlignment="Center">
        <views:HeroEmblem.LayoutTransform><ScaleTransform ScaleX="0.9" ScaleY="0.9" /></views:HeroEmblem.LayoutTransform>
      </views:HeroEmblem>
      <TextBlock Text="{StaticResource Scanning.Title}" Style="{StaticResource Hero.Title}" FontSize="38" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,15,0,9" />
      <TextBlock Text="{StaticResource Scanning.Subtitle}" Style="{StaticResource Hero.Body}" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
        <Border Style="{StaticResource Hero.Chip}"><TextBlock Text="{Binding ScanStageText}" Style="{StaticResource Hero.ChipText}" /></Border>
        <Border Style="{StaticResource Hero.Chip}" Visibility="{Binding ScanCountText, Converter={StaticResource EmptyToCollapsed}}">
          <TextBlock Text="{Binding ScanCountText}" Style="{StaticResource Hero.ChipText}" />
        </Border>
      </StackPanel>
      <TextBlock Text="{Binding ScanDetailText}" Style="{StaticResource Hero.Caption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"
                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="640" Opacity="0.7" />
    </StackPanel>

    <!-- SUMMARY (scrolls rather than clips when the window is at its minimum height) -->
    <ScrollViewer Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}}" Margin="18,64,18,70"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,26">
        <TextBlock Style="{StaticResource Hero.Title}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center">
          <Run Text="{StaticResource Summary.FoundPrefix}" /><Run Text="{Binding TotalApps, Mode=OneWay}" /><Run Text="{StaticResource Summary.FoundSuffix}" />
        </TextBlock>
        <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Hero.Caption}" HorizontalAlignment="Center" Margin="0,6,0,16" />
        <Button Style="{StaticResource Hero.Secondary}" Content="{StaticResource Summary.Manage}" Command="{Binding OpenManagerCommand}" HorizontalAlignment="Center" />
      </StackPanel>

      <Grid Grid.Row="1" MaxWidth="1120" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.95*" />
          <ColumnDefinition Width="2.05*" />
        </Grid.ColumnDefinitions>
        <!-- left: what is running right now -->
        <Border Grid.Column="0" Style="{StaticResource Hero.Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="96" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource Hero.CardTitle}">
                <Run Text="{StaticResource Summary.RunningPrefix}" /><Run Text="{Binding RunningCount, Mode=OneWay}" /><Run Text="{StaticResource Summary.RunningTitle}" />
              </TextBlock>
              <TextBlock Style="{StaticResource Hero.CardBody}">
                <Run Text="{StaticResource Summary.RunningBodyPrefix}" /><Run Text="{Binding PortableRunningCount, Mode=OneWay}" /><Run Text="{StaticResource Summary.RunningBodySuffix}" />
              </TextBlock>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Hero.BigTile}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Style="{StaticResource Hero.BulletIcon}" Width="30" Height="30" Stretch="Uniform" Data="M8,5 L19,12 L8,19 Z" />
            </Border>
            <Button Grid.Row="2" Style="{StaticResource Hero.CardButton}" Content="{StaticResource Summary.Inspect}" HorizontalAlignment="Right"
                    Command="{Binding OpenManagerCommand}" CommandParameter="Running" />
          </Grid>
        </Border>
        <!-- right: residue, undecided -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Hero.Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,80,8">
                <TextBlock Style="{StaticResource Hero.CardTitle}">
                  <Run Text="{StaticResource Summary.ResiduePrefix}" /><Run Text="{Binding ResidueCount, Mode=OneWay}" /><Run Text="{StaticResource Summary.ResidueTitle}" /><Run Text="{Binding ResidueSizeText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{StaticResource Summary.ResidueBody}" Style="{StaticResource Hero.CardBody}" />
              </StackPanel>
              <Border Grid.Row="0" Style="{StaticResource Hero.CornerTile}" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="✦" Style="{StaticResource Hero.CornerTileText}" />
              </Border>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Hero.CardButton}" Content="{StaticResource Summary.Inspect}" Command="{Binding OpenManagerCommand}" CommandParameter="Residue" />
                <Button Style="{StaticResource Hero.CardButtonPrimary}" Content="{StaticResource Summary.Remove}" Command="{Binding RemoveResidueCommand}" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Hero.Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,80,8">
                <TextBlock Style="{StaticResource Hero.CardTitle}">
                  <Run Text="{StaticResource Summary.UndeterminedPrefix}" /><Run Text="{Binding UndeterminedCount, Mode=OneWay}" /><Run Text="{StaticResource Summary.UndeterminedTitle}" />
                </TextBlock>
                <TextBlock Text="{StaticResource Summary.UndeterminedBody}" Style="{StaticResource Hero.CardBody}" />
              </StackPanel>
              <Border Grid.Row="0" Style="{StaticResource Hero.CornerTile}" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="?" Style="{StaticResource Hero.CornerTileText}" />
              </Border>
              <Button Grid.Row="1" Style="{StaticResource Hero.CardButton}" Content="{StaticResource Summary.View}" HorizontalAlignment="Right"
                      Command="{Binding OpenManagerCommand}" CommandParameter="Undetermined" />
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
        <Button Style="{StaticResource Hero.Link}" Command="{Binding ShowErrorsCommand}" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
          <TextBlock><Run Text="{StaticResource Scan.Errors}" /><Run Text=" (" /><Run Text="{Binding ErrorCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
        </Button>
        <Button Style="{StaticResource Hero.Link}" Content="{StaticResource Manager.AnalyzeFolder}" Command="{Binding AnalyzeFolderCommand}" />
        <Button Style="{StaticResource Hero.Link}" Content="{StaticResource Nav.Export}" Command="{Binding ExportReportCommand}" />
      </StackPanel>
    </Grid>
    </ScrollViewer>

    <!-- Bottom band with the one big button -->
    <Border VerticalAlignment="Bottom" Height="50" Background="#21041232" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0"
            Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" />
    <Grid VerticalAlignment="Bottom" Height="128">
      <Button Style="{StaticResource Hero.Round}" Content="{StaticResource Home.Scan}" Command="{Binding StartScanCommand}"
              Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" />
      <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" Width="112" Height="112" VerticalAlignment="Center">
        <Ellipse Stroke="#D9F8FF" StrokeThickness="5" StrokeDashArray="16 34" StrokeDashCap="Round" Margin="-6" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><RotateTransform x:Name="RingSpin" /></Ellipse.RenderTransform>
          <Ellipse.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="RingSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2.2" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Ellipse.Triggers>
        </Ellipse>
        <Button Style="{StaticResource Hero.Round}" Content="{StaticResource Scanning.Stop}" Command="{Binding CancelScanCommand}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>

<Window x:Class="WinAppInspector.UI.Views.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinAppInspector.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CleanupViewModel}"
        Title="{Binding Title}"
        Width="760" Height="600" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.WindowBackground}" FontFamily="{StaticResource Font.UI}">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
      <TextBlock Text="{StaticResource Cleanup.Intro}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <Grid>
        <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="12,8" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Mono}" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}" />
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{StaticResource Cleanup.PermanentTag}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.StatusAttention}" Margin="0,0,10,0"
                               Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{StaticResource Cleanup.ElevationTag}" Style="{StaticResource Text.Caption}" Margin="0,0,10,0"
                               Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding BlockedText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.StatusReminder}"
                               Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="12,2,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{StaticResource Cleanup.Nothing}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasItems, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Cleanup.UseRecycleBin}" IsChecked="{Binding UseRecycleBin, Mode=TwoWay}" />
      <TextBlock Text="{Binding PermanentWarningText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.StatusAttention}" Margin="0,0,0,6"
                 Visibility="{Binding NeedsPermanentAcknowledgement, Converter={StaticResource BoolToVisibility}}" />
      <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Cleanup.AcknowledgePermanent}" IsChecked="{Binding PermanentAcknowledged, Mode=TwoWay}"
                Visibility="{Binding NeedsPermanentAcknowledgement, Converter={StaticResource BoolToVisibility}}" />
      <CheckBox Style="{StaticResource Check.Body}" Content="{StaticResource Cleanup.Confirm}" IsChecked="{Binding UserConfirmed, Mode=TwoWay}" FontWeight="SemiBold" />
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding SelectedCount, StringFormat={StaticResource Cleanup.SelectedFormat}}" Style="{StaticResource Text.Caption}" />
        <TextBlock Text="{Binding SelectedSizeText, StringFormat=' · {0}'}" Style="{StaticResource Text.Caption}"
                   Visibility="{Binding SelectedSizeText, Converter={StaticResource EmptyToCollapsed}}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Toolbar.Button}" Content="{StaticResource Settings.Cancel}" MinWidth="90" Click="CancelClick" />
        <Button Style="{StaticResource Accent.Button}" Content="{StaticResource Cleanup.Execute}" MinWidth="110" Margin="8,0,0,0"
                IsEnabled="{Binding CanExecute}" Click="ExecuteClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

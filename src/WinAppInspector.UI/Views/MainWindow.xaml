<Window x:Class="WinAppInspector.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinAppInspector.UI.ViewModels"
        xmlns:views="clr-namespace:WinAppInspector.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{StaticResource App.Title}"
        Width="1240" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Hero.Background}"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Grid>
    <!-- Hero (home / scanning / summary) and manager share the window; only one is visible. -->
    <views:HomeView Visibility="{Binding IsHeroVisible, Converter={StaticResource BoolToVisibility}}" />
    <views:ManagerView Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Actions: uninstall, cleanup and restore-point operations. Every destructive call goes through Core's DeletionGuard first. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>WinAppInspector.Actions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinAppInspector.Core\WinAppInspector.Core.csproj" />
    <ProjectReference Include="..\WinAppInspector.Scanners\WinAppInspector.Scanners.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="TaskScheduler" />
  </ItemGroup>

</Project>
